rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny everything
    match /{document=**} {
      allow read, write: false;
    }

    // Existing appdata bulk-sync — require any authenticated user
    // (single-user app; email/password auth is the gate)
    match /appdata/{store} {
      allow read, write: if request.auth != null;
    }

    // Finance: per-document, UID-locked
    // users/{uid}/financeTransactions/{id}
    // users/{uid}/financeAccounts/{id}  etc.
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }
  }
}
